{
  "name": "dais-prototypes-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "mcp:check": "node scripts/check-mcp.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "prototype:new": "node scripts/new-prototype.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/scripts.test.mjs",
    "publish:check": "node scripts/publish.mjs check",
    "publish:setup": "node scripts/publish.mjs setup",
    "publish:wait": "node scripts/publish.mjs wait",
    "export:html": "node scripts/export-html.mjs"
  },
  "dependencies": {
    "@daisforge/ui": "1.27.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "lodash": "4.17.21",
    "marked": "16.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "1.5.4",
    "react-hook-form": "7.54.2",
    "react-responsive-carousel": "3.2.23",
    "styled-components": "5.3.1",
    "swr": "2.3.3"
  },
  "devDependencies": {
    "@daisforge/ui-mcp": "0.2.10",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@types/styled-components": "5.1.34",
    "@vitejs/plugin-react": "4.7.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vite-plugin-singlefile": "2.3.4"
  },
  "overrides": {
    "@salutejs/sdds-finai": "0.361.0",
    "@salutejs/plasma-icons": "1.252.0"
  }
}
